#include <iostream>

using namespace std;

class Movie {	
	int movieId,
		duration,
		price,
		ageRating;
	string title,
		   releaseDate,
		   genre,
		   language,
		   description;
public:
	Movie(int movieId, int duration, string releaseDate, int price, int ageRating, string title, string genre, string language) {
		this->movieId = movieId;
		this->duration = duration;
		this->releaseDate = releaseDate;
		this->price = price;
		this->ageRating = ageRating;
		this->title = title;
		this->genre = genre;
		this->language = language;
	}
	void setDescription(string description) {

		this->description = description;
	}
	int getId() {
		return movieId;
	}
	int getDuration() {
		return duration;
	}
	int getPrice() {
		return price;
	}
	int getAgeRating() {
		return ageRating;
	}
	string getTitle() {
		return title;
	}
	string getReleaseDate() {
		return releaseDate;
	}
	string getGenre() {
		return genre;
	}
	string getLanguage() {
		return language;
	}
	string getDescription() {
		return description;
	}
	
};

class MovieHall {
	int hallId,
		capacity;
	string name;
	Movie* movie;
public:
	MovieHall(int hallId, int capacity, string name, Movie* movie) {
		this->hallId = hallId;
		this->capacity = capacity;
		this->name = name;
		this->movie = movie;
	}
	int getHallId() {
		return hallId;
	}
	int getCapacity() {
		return capacity;
	}
	string getName() {
		return name;
	}
	Movie* getMovie() {
		return movie;
	}
};
class Seat {
	int seatId;
	bool isAvailable;
public:
	Seat(int seatId, bool isAvailable) {
		this->seatId = seatId;
		this->isAvailable = isAvailable;
	}
	int getSeatId() {
		return seatId;
	}
	bool getIsAvailable() {
		return isAvailable;
	}
};
class Ticket {
	int ticketId;
	Seat* seat;
	MovieHall* movieHall;
public:
	Ticket(int ticketId, Seat* seat, MovieHall* movieHall) {
		this->ticketId = ticketId;
		this->seat = seat;
		this->movieHall = movieHall;
	}
	int getTicketId() {
		return ticketId;
	}
	Seat* getSeat() {
		return seat;
	}
	MovieHall* getMovieHall() {
		return movieHall;
	}
};


